APP_NAME="Coffee Shop"
# Local development: set APP_ENV=local and APP_DEBUG=true.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://coffee.rizkilab.my.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

WWWUSER=1000
WWWGROUP=1000

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=coffee_shop
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@coffee.rizkilab.my.id"
MAIL_FROM_NAME="${APP_NAME}"

MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password

AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=coffee-shop
AWS_ENDPOINT_URL=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

WHATSAPP_ENABLED=false
FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Optional: AI copy generation (menu:generate-copy). Leave empty to disable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
